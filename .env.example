# Neon Postgres. Use the pooled (-pooler) host and keep ?sslmode=require.
DATABASE_URL=
# Bearer token the platform agent sends to /api/agent/jobs.
AGENT_API_TOKEN=
# Optional: public site URL used in links returned to the agent (else taken from forwarded headers).
PUBLIC_BASE_URL=
# NextGen platform backend origin (not the web app's address) and the public voice agent's platform id.
# The site's server calls {PLATFORM_API_URL}/api/public/agents/{VOICE_AGENT_ID}/web-call.
PLATFORM_API_URL=
VOICE_AGENT_ID=
# Used only when PLATFORM_API_URL is not set: create the call on Retell directly.
# Retell dashboard > API Keys (same workspace as the agent); the agent id starts with agent_.
RETELL_API_KEY=
RETELL_AGENT_ID=
