# Neon Postgres. Use the pooled (-pooler) host and keep ?sslmode=require.
DATABASE_URL=
# Bearer token the platform agent sends to /api/agent/jobs.
AGENT_API_TOKEN=
# Optional: public site URL used in links returned to the agent (else taken from forwarded headers).
PUBLIC_BASE_URL=
# Where "Talk to Angie" sends the browser (a page that runs the voice call). Unset: the button answers "not available yet".
VOICE_INTERVIEW_URL=
