# Neon Postgres. Use the pooled (-pooler) host and keep ?sslmode=require.
DATABASE_URL=
# Bearer token the platform agent sends to /api/agent/jobs.
AGENT_API_TOKEN=
# Optional: public site URL used in links returned to the agent (else taken from forwarded headers).
PUBLIC_BASE_URL=
# Retell voice agent behind "Talk to Angie". Key: Retell dashboard > API Keys.
# Agent id: the Retell agent (not the platform's own id). In the platform it is the agent's retellAgentId.
RETELL_API_KEY=
RETELL_AGENT_ID=
# Platform agent notified when a screening call ends (agent-invoke). Secret: platform > agent > invoke secrets (org admin).
PLATFORM_BASE_URL=
PLATFORM_AGENT_ID=
PLATFORM_INVOKE_SECRET=
